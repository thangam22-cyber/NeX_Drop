<Window x:Class="NeX_Drop.Shell.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NeX_Drop.Shell.Converters"
        Title="NeX_Drop"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="False"
        ShowInTaskbar="False"
        Background="{StaticResource BgDeep}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="48"/>    <!-- Taskbar -->
        </Grid.RowDefinitions>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="0">
            <!-- Background wave effect (like Win11) -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1117" Offset="0"/>
                        <GradientStop Color="#0A1628" Offset="0.5"/>
                        <GradientStop Color="#0D1117" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Two-column layout: left = main, right = sidebar -->
            <Grid Margin="40,36,40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: Welcome + App Grid ── -->
                <Grid Grid.Column="0" Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Welcome text -->
                        <RowDefinition Height="Auto"/>  <!-- Section label -->
                        <RowDefinition Height="*"/>     <!-- App tiles -->
                    </Grid.RowDefinitions>

                    <!-- Welcome Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,28">
                        <TextBlock Text="Welcome"
                                   FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="You are in "
                                       FontSize="15"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"/>
                            <TextBlock Text="{Binding ModeDisplay}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontFamily="{StaticResource FontUI}"/>
                            <TextBlock Text=". Only allowed applications are available."
                                       FontSize="15"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Allowed Applications Label -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="10,10,0,0"
                            Padding="20,14,20,14" Margin="0,0,0,1">
                        <TextBlock Text="Allowed Applications"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"/>
                    </Border>

                    <!-- App Tiles Grid -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,10,10"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AppTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AppTileStyle}"
                                                Command="{Binding DataContext.LaunchAppCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="42"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,10"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontFamily="{StaticResource FontUI}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="120"/>
                                                <!-- Remote badge -->
                                                <Border Visibility="{Binding IsRemote,
                                                          Converter={StaticResource BoolVis}}"
                                                        Background="#0D2137"
                                                        CornerRadius="4" Padding="6,2"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="INSTALL"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBlue}"
                                                               FontFamily="{StaticResource FontMono}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── RIGHT SIDEBAR ── -->
                <StackPanel Grid.Column="1">

                    <!-- Device Status Card -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card Header -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="Device Status"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"/>
                                <TextBlock Text="🛡" FontSize="18"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Divider -->
                            <Separator Grid.Row="1"
                                       Background="{StaticResource BorderBrush2}"
                                       Margin="0,6"/>

                            <!-- Status rows -->
                            <StackPanel Grid.Row="2">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Device ID" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource FontUI}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Status" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{Binding StatusColor}"
                                               FontFamily="{StaticResource FontUI}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Last Heartbeat" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"/>
                                    <TextBlock Text="{Binding HeartbeatText}" FontSize="13"
                                               Foreground="{StaticResource AccentGreen}"
                                               FontFamily="{StaticResource FontUI}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Mode" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ModeDisplay}" FontSize="13"
                                                   Foreground="{Binding ModeColor}"
                                                   FontFamily="{StaticResource FontUI}"/>
                                        <TextBlock Text=" (Active)" FontSize="13"
                                                   Foreground="{Binding ModeColor}"
                                                   FontFamily="{StaticResource FontUI}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Version" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource FontUI}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mode Information Card -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Mode Information"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"/>
                                <TextBlock Text="🔒" FontSize="18"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Separator Grid.Row="1"
                                       Background="{StaticResource BorderBrush2}"
                                       Margin="0,6"/>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Active Mode" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ModeDisplay}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{Binding ModeColor}"
                                           FontFamily="{StaticResource FontUI}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ModeDescription}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mode History Card (PRD §8) -->
                    <Border Style="{StaticResource InfoCardStyle}"
                            Visibility="{Binding HasModeHistory, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Mode History"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"/>
                                <TextBlock Text="🕒" FontSize="16"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Separator Grid.Row="1"
                                       Background="{StaticResource BorderBrush2}"
                                       Margin="0,6"/>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding ModeHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ModeDisplay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBlue}"
                                                           FontFamily="{StaticResource FontUI}"/>
                                                <TextBlock Text="{Binding ChangedBy}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="{StaticResource FontUI}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ChangedAt}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontFamily="{StaticResource FontUI}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Security Notice Card -->
                    <Border Style="{StaticResource InfoCardStyle}"
                            BorderBrush="#30363D">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Security Notice"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"/>
                                <Border HorizontalAlignment="Right"
                                        Background="#2D1215" CornerRadius="20"
                                        Width="32" Height="32">
                                    <TextBlock Text="⚠" FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentRed}"/>
                                </Border>
                            </Grid>
                            <Separator Grid.Row="1"
                                       Background="{StaticResource BorderBrush2}"
                                       Margin="0,6"/>
                            <StackPanel Grid.Row="2">
                                <TextBlock FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6">
                                    This device is protected by NeX_Drop.
                                </TextBlock>
                                <TextBlock Text="Unauthorized attempts will be logged."
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentRed}"
                                           FontFamily="{StaticResource FontUI}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══ TASKBAR ═══ -->
        <Border Grid.Row="1"
                Background="#0D1117"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                    <ColumnDefinition Width="*"/>     <!-- Status text -->
                    <ColumnDefinition Width="Auto"/>  <!-- Clock -->
                    <ColumnDefinition Width="Auto"/>  <!-- Power -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🛡" FontSize="16" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="NeX_Drop"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status text center -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🛡" FontSize="13" Margin="0,0,6,0"
                               Foreground="{StaticResource AccentBlue}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusBarText}"
                               FontSize="12"
                               Foreground="{StaticResource AccentBlue}"
                               FontFamily="{StaticResource FontUI}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Clock + Power -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding CurrentTime}"
                               FontSize="11" TextAlignment="Right"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- Power / Settings -->
                <Button Grid.Column="3"
                        Style="{StaticResource TaskbarBtnStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Admin Access">
                    <TextBlock Text="⏻" FontSize="18"
                               Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ ADMIN LOGIN OVERLAY ═══ -->
        <Grid Grid.RowSpan="2"
              Visibility="{Binding ShowAdminPanel, Converter={StaticResource BoolVis}}">
            <!-- Dim backdrop -->
            <Rectangle Fill="#AA000000"/>

            <!-- Login card -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Margin="32,28">

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔐" FontSize="22" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Admin Access Required"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Enter the administrator password to restore normal access."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <!-- Password label -->
                    <TextBlock Text="Password"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               Margin="0,0,0,6"/>

                    <!-- Password box -->
                    <PasswordBox x:Name="PwdBox"
                                 Style="{StaticResource NexPasswordBox}"
                                 PasswordChanged="PwdBox_PasswordChanged"
                                 KeyDown="PwdBox_KeyDown"
                                 Margin="0,0,0,8"/>

                    <!-- Error message -->
                    <TextBlock Text="{Binding AdminError}"
                               FontSize="12"
                               Foreground="{StaticResource AccentRed}"
                               FontFamily="{StaticResource FontUI}"
                               Visibility="{Binding HasAdminError, Converter={StaticResource BoolVis}}"
                               Margin="0,0,0,16"/>

                    <!-- Buttons -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel -->
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CancelAdminCommand}"
                                Height="38" FontSize="14"
                                FontFamily="{StaticResource FontUI}"
                                Background="{StaticResource BgCard2}"
                                Foreground="{StaticResource TextPrimary}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="#21262D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Unlock -->
                        <Button Grid.Column="2"
                                Content="Unlock"
                                Command="{Binding AdminLoginCommand}"
                                Height="38" FontSize="14" FontWeight="SemiBold"
                                FontFamily="{StaticResource FontUI}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1F6FEB" Offset="0"/>
                                                <GradientStop Color="#388BFD" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
